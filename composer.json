{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "creativeorange/gravatar": "~1.0",
        "dyrynda/laravel-cascade-soft-deletes": "^4.1",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/cashier": "^13.6",
        "laravel/framework": "^9.0",
        "laravel/sanctum": "^2.9",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.3",
        "livewire/livewire": "^2.12",
        "maatwebsite/excel": "^3.1",
        "mikehaertl/php-pdftk": "^0.11.0",
        "opcodesio/log-viewer": "^1.6",
        "orangehill/iseed": "^3.0",
        "silber/bouncer": "^1.0",
        "spatie/browsershot": "^3.55",
        "spatie/laravel-stripe-webhooks": "^3.1",
        "staudenmeir/eloquent-has-many-deep": "^1.15",
        "stripe/stripe-php": "^7.110",
        "wire-elements/modal": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.12",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.3",
        "psy/psysh": "0.11.2",
        "spatie/laravel-ignition": "^1.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": ["tests/suspended_features"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
