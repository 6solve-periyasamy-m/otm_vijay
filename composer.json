{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "bacon/bacon-qr-code": "^3.0",
        "barryvdh/laravel-dompdf": "^v3.0.0-beta2",
        "creativeorange/gravatar": "~1.0",
        "dyrynda/laravel-cascade-soft-deletes": "^4.1",
        "fakerphp/faker": "^1.23",
        "guzzlehttp/guzzle": "^7.0.1",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^10.49.1",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^4.0",
        "livewire/livewire": "^2.12",
        "lorisleiva/laravel-actions": "^2.8",
        "maatwebsite/excel": "^3.1",
        "mediconesystems/livewire-datatables": "^0.10.1",
        "mikehaertl/php-pdftk": "^0.11.0",
        "opcodesio/log-viewer": "^1.6",
        "orangehill/iseed": "^3.0",
        "pragmarx/google2fa-laravel": "^2.2",
        "propaganistas/laravel-phone": "^5.3",
        "silber/bouncer": "^1.0",
        "spatie/browsershot": "^5.0",
        "staudenmeir/eloquent-has-many-deep": "^1.15",
        "stevebauman/location": "^7.2",
        "stripe/stripe-php": "^19.0",
        "vyuldashev/laravel-openapi": "^1.10",
        "wire-elements/modal": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "barryvdh/laravel-ide-helper": "^2.12",
        "brianium/paratest": "^7.0",
        "larastan/larastan": "^2.0",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^7.0",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-doctrine": "^1.5",
        "phpunit/phpunit": "^10.0",
        "psy/psysh": "0.11.2",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "helpers/auth.php",
            "helpers/formatting.php",
            "helpers/images.php",
            "helpers/internal.php",
            "helpers/pdf.php",
            "helpers/settings.php",
            "helpers/ui.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": ["tests/"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "phpstan": "vendor/bin/phpstan analyse app"
    }
}
